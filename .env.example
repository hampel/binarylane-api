# Copy this file to .env beside the package. The rig loads it - unless an agent is running
# the command, in which case it deliberately does not; see harness/lib/harness.php.

# A BinaryLane API token, from the control panel.
#
# THERE IS ONLY ONE KIND. BinaryLane tokens carry no scopes and no expiry, so the token that
# reads an account is the token that could cancel a server - there is no read-only variant to
# put here. That is why the write exercises are guarded by environment variables rather than
# by the credential, and why those guards matter more in this package than in most.
BINARYLANE_API_TOKEN=

# Optional. Which DNS zone the dns and dns-write exercises work on. dns falls back to the
# first zone on the account; dns-write requires this to be set, because a zone chosen for you
# is not a zone you meant to write to.
BINARYLANE_DNS_ZONE=

# Optional. An image slug for the catalogue exercise's filter probe. Left unset it picks the
# first distribution it can see, which is usually a common one available everywhere - and a
# filter that narrows nothing cannot be told from a filter that is ignored. Set this to
# something scarcer to make the probe say something.
BINARYLANE_IMAGE=

# Optional, for the server-action exercise. Which server to perform the action on.
BINARYLANE_SERVER_ID=

# Optional. Set to exactly 1 to let dns-write create and delete a throwaway TXT record in
# BINARYLANE_DNS_ZONE. Anything else, including 0 and unset, reads the zone and stops.
#
# The default is that way round because the failure being guarded against is a session that
# does not know a populated .env is sitting here - and such a session does not know about a
# flag either. An opt-in guard protects only people who already knew.
BINARYLANE_DNS_WRITE=

# Optional. Set to exactly 1 to let server-action perform a real `uptime` action on
# BINARYLANE_SERVER_ID. Uptime changes nothing; the switch exists because "an action was
# performed on a production server" is a sentence that should follow a decision.
BINARYLANE_RUN_ACTION=

# There are two more variables the harness reads, deliberately not listed above, because this
# file is meant to be copied to .env and they must never live in one:
#
#   BINARYLANE_AGENT_MAY_WRITE_DNS=1     dns-write may write, in an agent session
#   BINARYLANE_AGENT_MAY_RUN_ACTION=1    server-action may act, in an agent session
#
# Each unlocks, for a single run, the switch immediately above it. BINARYLANE_DNS_WRITE and
# BINARYLANE_RUN_ACTION are otherwise ignored when CLAUDECODE is set - because they are read
# from a file written by whoever owns the token, which generally authorises the real thing,
# and an agent would inherit an authorisation nobody gave it. Put one of these on the command
# line for one run. Written into .env it stops being a deliberate act, which is the whole of
# what it is for.
